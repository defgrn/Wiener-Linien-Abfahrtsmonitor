String fixUmlaute(String text) {
  text.replace("ä", "\x84");
  text.replace("ö", "\x94");
  text.replace("ü", "\x81");
  text.replace("Ä", "\x8E");
  text.replace("Ö", "\x99");
  text.replace("Ü", "\x9A");
  text.replace("ß", "ss");
  return text;
}



void abfahrten() {
  tft.fillScreen(ST77XX_BLACK);
  tft.setTextColor(ST77XX_WHITE);
  
  tft.setTextSize(2);
  tft.setCursor(10, 15);
  tft.println(fixUmlaute(empfangeneDaten.station));
  tft.drawFastHLine(0, 45, 240, ST77XX_WHITE); 

  tft.setCursor(10, 65);
  tft.setTextSize(4);
  tft.setTextColor(ST77XX_RED);
  tft.print(empfangeneDaten.linie); 

  tft.setTextColor(ST77XX_WHITE);
  tft.setTextSize(2);
  tft.setCursor(10, 115);
  
  String richtung = empfangeneDaten.richtung;
  if (richtung.length() > 15) {
    tft.println(fixUmlaute(richtung.substring(0, 14)));
    tft.setCursor(10, 140);
    tft.println(fixUmlaute(richtung.substring(14)));
  } else {
    tft.println(fixUmlaute(richtung));
  }

  tft.drawFastHLine(0, 175, 240, ST77XX_WHITE);

  tft.setCursor(10, 190);
  tft.setTextSize(6);
  tft.setTextColor(ST77XX_RED);
  if(empfangeneDaten.minuten == 0) {
    tft.print("*");
  } else {
    tft.print(empfangeneDaten.minuten);
  }
  
  tft.setTextSize(2);
  tft.setTextColor(ST77XX_WHITE);
  tft.print(" min");
}

void OnDataRecv(const esp_now_recv_info_t * info, const uint8_t *incomingData, int len) {
  int size = sizeof(empfangeneDaten);
  if (len < size) size = len;
  memcpy(&empfangeneDaten, incomingData, size);

  if (!ersteDatenEmpfangen) {
      anzeigeStartMillis = millis();
      ersteDatenEmpfangen = true;
  }

  Serial.print("Minuten empfangen: ");
  Serial.println(empfangeneDaten.minuten);
  if (millis() - anzeigeStartMillis >= 18000) {
      abfahrten();
  }
}

void setup() {
  Serial.begin(115200);
  WiFi.mode(WIFI_STA);
  esp_wifi_set_promiscuous(true);
  esp_wifi_set_channel(6, WIFI_SECOND_CHAN_NONE);
  esp_wifi_set_promiscuous(false);
  Serial.print("Kanal Empfängers: ");
  Serial.println(WiFi.channel());
  pinMode(DAC_PIN, OUTPUT);

  tft.init(240, 240);           
  tft.setRotation(3);
  tft.fillScreen(ST77XX_BLACK);
  tft.drawBitmap(40, 80, booat, 160, 80, ST77XX_WHITE);
  splashStart = millis();

  if (esp_now_init() != ESP_OK) {
    Serial.println("Fehler Initialisieren Esp Now");
    return;
  } 
  esp_now_register_recv_cb(OnDataRecv);
}

void loop() {
  unsigned long currentMillis = millis();
  unsigned long passed = currentMillis - splashStart;

  // Splash + Datenverbindung (0 bis 3 bis [wlan connect zeit] sek)
  if (!splashDone) {
    if (passed < 3000) {
      return;
    } else {
      splashDone = true;
      tft.fillScreen(ST77XX_BLACK);
      tft.setTextSize(2);
      tft.setTextColor(ST77XX_WHITE);
      tft.setCursor(20, 110);
      tft.println("Warte auf Daten...");
    }
  }

  // Webserver IP anzeigen ([wlan connect zeit] bis 18 sek)
  if (ersteDatenEmpfangen && (currentMillis - anzeigeStartMillis < 18000)) {
    static int lastSecond = -1;
    int currentSecond = (18000 - (currentMillis - anzeigeStartMillis)) / 1000;
    
    if (currentSecond != lastSecond) {
      lastSecond = currentSecond;
      tft.fillScreen(ST77XX_BLACK);
      tft.setTextColor(ST77XX_WHITE);
      
      tft.setTextSize(2);
      tft.setCursor(10, 30);
      tft.println("Webserver IP:");
      tft.setTextSize(3);
      tft.setTextColor(ST77XX_RED);
      tft.setCursor(10, 80);
      tft.println(empfangeneDaten.ipwebserver);
      
      tft.setTextSize(2);
      tft.setTextColor(ST77XX_WHITE);
      tft.setCursor(10, 180);
      tft.print("Startet in: ");
      tft.print(currentSecond);
      tft.println("s");
    }
  }

  // Daten nach 18 sek
  static bool uevergangErledigt = false;
  if (ersteDatenEmpfangen && !uevergangErledigt && (currentMillis - anzeigeStartMillis >= 18000)) {
    abfahrten(); 
    uevergangErledigt = true;
  }
}